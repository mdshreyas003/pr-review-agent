# Copy to .env and fill in. Never commit the filled-in copy.

# ---- app ----------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
QUEUE_MODE=redis               # redis (worker) | inline (runs in the request)

# ---- data spine -----------------------------------------------------------
DATABASE_URL=postgresql://prreview:prreview@localhost:5432/prreview
REDIS_URL=redis://localhost:6379/0
ENABLE_TIMESCALEDB=true        # false degrades gracefully to plain Postgres

# ---- specialists ------------------------------------------------------------
ENABLED_AGENTS=                # comma-separated subset of security,quality,tests,docs,story - blank = all five

# ---- LLM provider -----------------------------------------------------------
LLM_PROVIDER=azure_foundry

# ---- Azure Foundry (Kimi K2) ------------------------------------------------
FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
FOUNDRY_DEPLOYMENT=Kimi-K2-Thinking   # the *deployment* name from the portal, not the model name - a mismatch is a 404
FOUNDRY_API_KEY=
FOUNDRY_USE_ENTRA_ID=false     # true + blank key runs keyless via managed identity / az-cli login
FOUNDRY_TIMEOUT_SECONDS=300
FOUNDRY_COST_INPUT_PER_MTOK=0  # from the Foundry pricing page - left at 0, BudgetGuard can't protect you
FOUNDRY_COST_OUTPUT_PER_MTOK=0
MAX_TOKENS_PER_AGENT=8000      # too low and a reasoning model returns thinking with no JSON

# ---- Azure DevOps -----------------------------------------------------------
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PROJECT=YourProject
ADO_API_VERSION=7.1
ADO_REPOSITORIES=              # comma-separated repo names/GUIDs to watch - blank = whole project

# "pat" (HTTP Basic) or "service_principal" (Entra ID app + client certificate).
# service_principal still needs adding as a user in ADO (Organization Settings
# -> Users) with Code (read & write), Work Items (read), Project and Team (read).
ADO_AUTH_MODE=service_principal
ADO_TENANT_ID=
ADO_CLIENT_ID=
ADO_CLIENT_CERTIFICATE_HOST_PATH=./secrets/ado-service-principal.pem  # host path, bind-mounted by docker-compose
ADO_CLIENT_CERTIFICATE_PATH=/run/secrets/ado-service-principal.pem    # in-container path the app actually reads

# Service hooks authenticate with HTTP Basic, not an HMAC signature - put these
# same values in the subscription's "Basic authentication" fields.
ADO_WEBHOOK_USERNAME=prreview
ADO_WEBHOOK_PASSWORD=

# ---- code-memory backend -----------------------------------------------------
MEMORY_BACKEND=vector          # "vector": Postgres pgvector + full-text | "mem0": separate mem0 server

# ---- embeddings (Azure OpenAI) - vector backend only, optional --------------
AZURE_OPENAI_ENDPOINT=         # blank skips the vector lane, falls back to full-text search only
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSIONS=256

# ---- mem0 (code-memory) - only used when MEMORY_BACKEND=mem0 ----------------
MEM0_BASE_URL=http://host.docker.internal:8888
MEM0_API_KEY=

# ---- autonomy gates ---------------------------------------------------------
REQUIRE_HUMAN_APPROVAL=true    # master switch - no review posts without a human approving it while true

# Only consulted when REQUIRE_HUMAN_APPROVAL=false.
AUTO_POST_MIN_CONFIDENCE=0.75
ESCALATE_ON_CRITICAL=true
MIN_FINDING_CONFIDENCE=0.35
MAX_FINDINGS_POSTED=25

# ---- economics --------------------------------------------------------------
DAILY_BUDGET_USD=25
PER_REVIEW_BUDGET_USD=2
BUDGET_GUARD_ENABLED=true
